directional <- second_sg_sbjv %>%
filter(median_llfpm10 - llfpm10 > threshold * 0.2 &
median_llfpm10 - llfpm10 < threshold * 1.2) %>%
filter(long_short_sbjv_log_odds - median_long_short_sbjv_log_odds > threshold * 0.2 &
long_short_sbjv_log_odds - median_long_short_sbjv_log_odds < threshold * 8) %>%
