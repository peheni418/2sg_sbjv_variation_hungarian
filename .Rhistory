data <- data |>
mutate(word_order = map_chr(row_number(), ~{
s <- stem[.x]
a <- acc[.x]
n <- nom[.x]
v <- value[.x]
if (is.na(s) | is.na(a)) return(NA_character_)
s_esc <- str_replace_all(s, "([\\[\\](){}.*+?^$|\\\\])", "\\\\\\1")
a_esc <- str_replace_all(a, "([\\[\\](){}.*+?^$|\\\\])", "\\\\\\1")
n_esc <- str_replace_all(n, "([\\[\\](){}.*+?^$|\\\\])", "\\\\\\1")
pos_s <- gregexpr(paste0("\\b", s_esc, "\\b"), v)[[1]][1]
pos_a <- gregexpr(paste0("\\b", a_esc, "\\b"), v)[[1]][1]
pos_n <- if (is.na(n)) -Inf else gregexpr(paste0("\\b", n_esc, "\\b"), v)[[1]][1]
if (pos_s == -1 | pos_a == -1) return(NA_character_)
if (!is.na(n) & pos_n == -1) return(NA_character_)
if (is.na(n)) {
if (pos_s < pos_a) return("VO")
else return("OV")
}
order <- order(c(pos_s, pos_a, pos_n))
positions <- c("V", "A", "N")[order]
return(paste0(positions, collapse = ""))
}))
