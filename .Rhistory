library(tidyverse)
library(here)
data <- readLines(file) |>
iconv(from = "ISO-8859-2", to = "UTF-8") |>
as_tibble() |>
mutate(stem = str_extract(value, "(?<=stem@@)[^ ]+"),
acc = str_extract(value, "(?<=ACC@@)[^ ]+"),
nom = str_extract(value, "(?<=NOM@@)[^ ]+")) |>
mutate(across(where(is.character), ~na_if(., "NULL"))) |>
filter(!is.na(acc)) |>
mutate(word_order = map_chr(row_number(), ~{
s <- stem[.x]
a <- acc[.x]
n <- nom[.x]
v <- value[.x]
if (is.na(s) | is.na(a)) return(NA_character_)
pos_s <- gregexpr(paste0("\\b", s, "\\b"), v)[[1]][1]
pos_a <- gregexpr(paste0("\\b", a, "\\b"), v)[[1]][1]
pos_n <- if (is.na(n)) -Inf else gregexpr(paste0("\\b", n, "\\b"), v)[[1]][1]
if (pos_s == -1 | pos_a == -1) return(NA_character_)
if (!is.na(n) & pos_n == -1) return(NA_character_)
if (is.na(n)) {
if (pos_s < pos_a) return("VO")
else return("OV")
}
order <- order(c(pos_s, pos_a, pos_n))
positions <- c("V", "A", "N")[order]
return(paste0(positions, collapse = ""))
}))
