process_all_files <- function(folder_name) {
folder_path <- here(folder_name)
files <- list.files("C:/Users/Pokk Heni/Documents/Péhádédoktoriphd/2025_26_elso_ev/Barcelonasmus/sanyi/hungarian_word_order/mazsola_adatbazis.txt", pattern = "//.txt$", full.names = TRUE)
for (file in files) {
data <- readLines(file) |>
iconv(from = "ISO-8859-2", to = "UTF-8") |>
as_tibble() |>
mutate(stem = str_extract(value, "(?<=stem@@)[^ ]+"),
acc = str_extract(value, "(?<=ACC@@)[^ ]+"),
nom = str_extract(value, "(?<=NOM@@)[^ ]+")) |>
mutate(across(where(is.character), ~na_if(., "NULL"))) |>
filter(!is.na(acc))
output_file <- paste0(file, "_processed.csv")
write_csv(data, output_file)
}
}
